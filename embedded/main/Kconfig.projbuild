menu "YX Gateway Debug Options"

config GW_DEBUG_CONSOLE
    bool "Enable local debug console"
    default n
    help
        Enable the local debug console. Release builds should keep this disabled.

config GW_DEBUG_MQTT_TRACE
    bool "Enable MQTT trace logs"
    default n
    help
        Enable verbose MQTT send/receive trace logs for diagnostics.

config GW_DEBUG_HTTP_TRACE
    bool "Enable HTTP trace logs"
    default n
    help
        Enable verbose HTTP trace logs for diagnostics.

config GW_DEBUG_SCRIPT_TRACE
    bool "Enable script runtime trace logs"
    default n
    help
        Enable verbose MicroPython runtime trace logs for diagnostics.

config GW_FAULT_INJECT
    bool "Enable fault injection hooks"
    default n
    help
        Enable fault injection hooks used by development tests only.

endmenu
